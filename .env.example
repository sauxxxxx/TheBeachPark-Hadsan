# Canonical public origin, without a trailing slash.
VITE_SITE_URL=https://thebeachpark.com

# Official URL supplied for Exely property 507010. Leave blank until approved.
VITE_EXELY_BOOKING_URL=

# Supported adapter modes: external, popup, iframe, or pending.
# This front-end currently opens an approved external URL when configured.
VITE_EXELY_INTEGRATION_MODE=pending

# Server-only Google Places API key used by /api/google-reviews.
# Configure the real value as a Secret in Vercel; never prefix it with VITE_.
GOOGLE_PLACES_API_KEY=
