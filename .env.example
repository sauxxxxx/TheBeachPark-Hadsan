# Canonical public origin, without a trailing slash.
VITE_SITE_URL=https://thebeachpark.com

# The supplied Exely integration is configured in src/data/exelyIntegration.js.
# Booking, search, and reputation widgets use the official property scripts.

# Server-only Google Places API key used by /api/google-reviews.
# Configure the real value as a Secret in Vercel; never prefix it with VITE_.
GOOGLE_PLACES_API_KEY=
